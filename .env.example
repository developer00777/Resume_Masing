# ──────────────────────────────────────────────────────────────────────────────
# Salesforce Resume Masking Service — environment configuration
# Copy to `.env` for local dev, or set these as Railway service variables in prod.
# SECURITY: real creds live HERE (service env / Railway secrets) — NEVER in code,
# NEVER in the "Generate Masking" button URL. The button passes only the Job Applicant Id.
# ──────────────────────────────────────────────────────────────────────────────

# --- Auth mode A: Username + Password + Security Token (simplest) ---------------
# The Salesforce INTEGRATION USER (not a person's daily login). Password is that
# user's password; security token is appended automatically by simple-salesforce.
SF_USERNAME=integration.user@yourcompany.com
SF_PASSWORD=replace-with-integration-user-password
SF_SECURITY_TOKEN=replace-with-security-token        # Setup > Reset My Security Token

# --- Auth mode B: Connected App (OAuth2 username-password) — OPTIONAL -----------
# If SF_CONSUMER_KEY is set (and SF_CLIENTS_JSON below is NOT), the service uses
# this Connected App flow instead of the security-token flow above (still needs
# SF_USERNAME + SF_PASSWORD). Leave blank to use mode A. Create under
# Setup > App Manager > New Connected App.
# SF_CONSUMER_KEY=replace-with-connected-app-consumer-key
# SF_CONSUMER_SECRET=replace-with-connected-app-consumer-secret

# --- Login host (modes A/B only) -------------------------------------------------
# This is the HOST PREFIX simple-salesforce builds https://{SF_DOMAIN}.salesforce.com
# from, not a word describing the org.
# "login"  = production / developer org (default)
# "test"   = sandbox
# or a My Domain host, e.g. "yourcompany.my.salesforce.com"
# "Live" / "prod" / "production" are read as "login" (and "sandbox" as "test"):
# the deployed configuration used "Live", which resolved to nothing and failed
# every connection with a DNS error rather than an auth error.
SF_DOMAIN=login

# --- Queue and workers ------------------------------------------------------
# REDIS_URL turns on the async queue. On Railway, add a Redis service and it
# injects this itself. Without it the async endpoints report that they are
# disabled and the synchronous ones are unaffected.
# REDIS_URL=redis://localhost:6379/0
#
# How many resumes are masked at once, ACROSS EVERY CONTAINER — the gate is a
# lease held in Redis, not a per-process semaphore, so the web service and any
# number of workers share this one number. Work beyond it waits in the queue;
# it is never refused and never dropped.
# MASK_MAX_CONCURRENT=10
#
# Set to 0 on the WEB service once a worker container is running, so the API
# stops draining the queue and keeps its CPU for serving requests. Leave it
# unset (or 1) and the web service drains too, which is the behaviour when
# there is no worker container. The worker container leaves this unset.
# MASK_RUN_WORKERS=1
#
# Above this many items, POST /mask/batch stops masking inside the request and
# hands the batch to the queue, returning {"status":"queued","job_id":...} for
# the caller to poll at GET /mask/jobs/{job_id}. 0 disables the hand-off, so a
# caller that expects its results inline keeps getting them. Turning this on
# changes what that caller receives — coordinate it with the Apex side.
# MASK_BATCH_ASYNC_THRESHOLD=10
#
# THE WORKER CONTAINER: same repo, same Dockerfile, same variables, with the
# start command overridden to
#     python -m app.worker
# On Railway: New Service > from this repo > Settings > Start Command. Give it
# the same REDIS_URL and Salesforce variables as the web service. Scale it by
# adding replicas; MASK_MAX_CONCURRENT still caps them all together.

# --- Auth mode C: Multi-client OAuth2 Client Credentials — RECOMMENDED for -------
# multiple Salesforce orgs/clients (e.g. multiple RecruitChamp customers), each
# with its own Connected App. Fully headless: no username/password stored here at
# all — each org's Connected App must have a dedicated "Execution User" assigned
# (Setup > App Manager > your Connected App > Edit Policies > Run As), and that
# user's profile needs "API Only" + the object permissions /mask and
# /watermark/upload need (read ContentDocumentLink/ContentVersion, create
# ContentVersion).
#
# JSON object keyed by "client_key" — by convention, the org's own Salesforce
# Organization Id (Apex: UserInfo.getOrganizationId()), so callers never have
# to invent/coordinate a label. Callers pass this client_key in the /mask,
# /mask/batch, and /watermark/upload request body to select which org to use.
# This is a STATIC fallback/seed -- requires a redeploy to add/change an
# entry. For dynamic registration without a redeploy, see the Postgres-backed
# registry below (DATABASE_URL) -- entries there win on client_key collision
# with this env var, and can be added via POST /clients/self-register or
# PUT /admin/clients/{client_key} at runtime.
#
# SF_CLIENTS_JSON={"00D5f000000ABCDEAU":{"client_id":"3MVG9...","client_secret":"64585...","token_url":"https://acme.my.salesforce.com/services/oauth2/token","instance_url":"https://acme.my.salesforce.com"}}

# --- Dynamic client-org registry (Postgres) — OPTIONAL, enables runtime -----------
# registration of new client orgs without a redeploy (POST /clients/self-register,
# PUT /admin/clients/{client_key}) instead of hand-editing SF_CLIENTS_JSON above.
# Fully optional: if DATABASE_URL is unset, the service behaves exactly as if
# this whole section didn't exist (SF_CLIENTS_JSON-only).
#
# Normally auto-injected by Railway when you link a Postgres service to this
# one -- don't hand-set in production; only needed for local Docker testing
# against a local Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# Symmetric key used to encrypt client_secret before it's ever written to
# Postgres (never stored in plaintext). Required only once DATABASE_URL is
# set AND a client actually gets registered/read from the DB. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CLIENT_SECRET_ENCRYPTION_KEY=

# --- Server (Railway sets PORT automatically; only needed for local Docker) ------
# PORT=8000

# --- Endpoint auth (RECOMMENDED once this leaves the pilot client) --------------
# Shared secret required as the X-API-Key header on POST /mask, POST /mask/batch,
# POST /mask/inline, POST /watermark/upload, and POST /clients/self-register.
# Unset = unenforced (anyone with the Railway URL can call them). /popup templates
# this into its own fetch() calls automatically, so the Salesforce-embedded page
# keeps working once you set it. Generate with:
# openssl rand -hex 32
# MASK_API_KEY=

# --- Admin API auth (REQUIRED to use /admin/clients at all) ---------------------
# Separate, higher-privilege secret from MASK_API_KEY -- required as the
# X-Admin-API-Key header on GET/PUT/DELETE /admin/clients (register/update/
# remove/list any client org, including credential rotation). Unlike
# MASK_API_KEY, this FAILS CLOSED (503) if unset -- admin routes are more
# sensitive than the Salesforce-facing endpoints, so a forgotten key must not
# silently mean "open". Generate with:
# openssl rand -hex 32
# ADMIN_API_KEY=
