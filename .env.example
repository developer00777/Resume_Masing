# ──────────────────────────────────────────────────────────────────────────────
# Salesforce Resume Masking Service — environment configuration
# Copy to `.env` for local dev, or set these as Railway service variables in prod.
# SECURITY: real creds live HERE (service env / Railway secrets) — NEVER in code,
# NEVER in the "Generate Masking" button URL. The button passes only the Job Applicant Id.
# ──────────────────────────────────────────────────────────────────────────────

# --- Auth mode A: Username + Password + Security Token (simplest) ---------------
# The Salesforce INTEGRATION USER (not a person's daily login). Password is that
# user's password; security token is appended automatically by simple-salesforce.
SF_USERNAME=integration.user@yourcompany.com
SF_PASSWORD=replace-with-integration-user-password
SF_SECURITY_TOKEN=replace-with-security-token        # Setup > Reset My Security Token

# --- Auth mode B: Connected App (OAuth2 username-password) — OPTIONAL -----------
# If SF_CONSUMER_KEY is set (and SF_CLIENTS_JSON below is NOT), the service uses
# this Connected App flow instead of the security-token flow above (still needs
# SF_USERNAME + SF_PASSWORD). Leave blank to use mode A. Create under
# Setup > App Manager > New Connected App.
# SF_CONSUMER_KEY=replace-with-connected-app-consumer-key
# SF_CONSUMER_SECRET=replace-with-connected-app-consumer-secret

# --- Login host (modes A/B only) -------------------------------------------------
# "login"  = production / developer org (default)
# "test"   = sandbox
# or a My Domain host, e.g. "yourcompany.my.salesforce.com"
SF_DOMAIN=login

# --- Auth mode C: Multi-client OAuth2 Client Credentials — RECOMMENDED for -------
# multiple Salesforce orgs/clients (e.g. multiple RecruitChamp customers), each
# with its own Connected App. Fully headless: no username/password stored here at
# all — each org's Connected App must have a dedicated "Execution User" assigned
# (Setup > App Manager > your Connected App > Edit Policies > Run As), and that
# user's profile needs "API Only" + the object permissions /mask and
# /watermark/upload need (read ContentDocumentLink/ContentVersion, create
# ContentVersion).
#
# JSON object keyed by an arbitrary "client_key" — callers pass this client_key
# in the /mask and /watermark/upload request body to select which org to use.
# When SF_CLIENTS_JSON is set, it takes priority over modes A/B for any request
# that supplies a client_key; requests without a client_key still fall back to
# modes A/B if those are also configured.
#
# SF_CLIENTS_JSON={"acme":{"client_id":"3MVG9...","client_secret":"64585...","token_url":"https://acme.my.salesforce.com/services/oauth2/token","instance_url":"https://acme.my.salesforce.com"},"beta_corp":{"client_id":"3MVG9...","client_secret":"...","token_url":"https://beta-corp.my.salesforce.com/services/oauth2/token","instance_url":"https://beta-corp.my.salesforce.com"}}

# --- Server (Railway sets PORT automatically; only needed for local Docker) ------
# PORT=8000

# --- Endpoint auth (RECOMMENDED once this leaves the pilot client) --------------
# Shared secret required as the X-API-Key header on POST /mask and
# POST /watermark/upload. Unset = unenforced (anyone with the Railway URL can call
# them). /popup templates this into its own fetch() calls automatically, so the
# Salesforce-embedded page keeps working once you set it. Generate with:
# openssl rand -hex 32
# MASK_API_KEY=
